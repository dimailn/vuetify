{
  "extends": "../../tsconfig.json",
  "include": [
    "src"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "lib": [
      "es2015",
      "es2016",
      "es2017",
      "es2018",
      "es2019",
      "dom",
      "dom.iterable"
    ],
    "skipLibCheck": true,
    "paths": {
      "@/test/*": ["test/*"],
      "@*": ["src/*"],
      "vue": ["../../node_modules/vue"]
    }
  }
}
